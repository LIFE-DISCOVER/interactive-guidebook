# Copy to .env and fill in. Never commit the real .env.
DOMAIN=guidebook.example.org
DJANGO_SECRET_KEY=change-me-run-python3-c-import-secrets-print-secrets.token_urlsafe-50

# Administrator created on first launch; the setup page is then skipped.
# Only used while no account exists. Remove the password once you have signed in.
# Leave both empty to use the setup page instead (setup code is in the logs:
# docker compose logs web | grep "Setup code").
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Optional: "Edit on GitHub" links in the admin for countries, steps and services.
CONTENT_REPO_URL=https://github.com/LIFE-DISCOVER/interactive-guidebook/edit/main/data/
